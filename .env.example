# ==============================================================================
# RentalHub Environment Configuration (.env.example)
# ==============================================================================

# Global Secrets & Infrastructure
JWT_SECRET=dev-secret-change-me
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL & RabbitMQ Credentials (used by Docker Compose)
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
RABBITMQ_DEFAULT_USER=rental
RABBITMQ_DEFAULT_PASS=rental

# RabbitMQ Connection URL (for local dev outside Docker)
RABBITMQ_URL=amqp://rental:rental@localhost:5672

# Admin Bootstrap Credentials
ADMIN_EMAIL=admin@rental.local
ADMIN_PASSWORD=admin12345

# Database URLs for Local Development (outside Docker)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
AUTH_DATABASE_URL=postgres://rental:rental@localhost:5432/auth_db
PROPERTY_DATABASE_URL=postgres://rental:rental@localhost:5432/property_db
ACCOUNTING_DATABASE_URL=postgres://rental:rental@localhost:5432/accounting_db
COMMERCE_DATABASE_URL=postgres://rental:rental@localhost:5432/commerce_db

# Microservice Local Ports
GATEWAY_PORT=8080
FRONTEND_PORT=4200
AUTH_PORT=4001
PROPERTY_PORT=4002
ACCOUNTING_PORT=4003
COMMERCE_PORT=4004

# API Gateway Route Targets (used by api-gateway when running locally)
AUTH_SERVICE_URL=http://localhost:4001
PROPERTY_SERVICE_URL=http://localhost:4002
ACCOUNTING_SERVICE_URL=http://localhost:4003
COMMERCE_SERVICE_URL=http://localhost:4004
